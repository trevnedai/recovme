{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecovMe",
  "version": "0.1.0",
  "identifier": "app.recovme.recovery",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RecovMe",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": [],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Free file and photo recovery",
    "longDescription": "Bring back deleted photos, videos and documents from SD cards, USB sticks, external drives, hard disks, Android phones and iPhone backups. Free and open source.",
    "copyright": "© 2026 Dhan Denvert Asuncion. GPL-3.0-or-later. Uses PhotoRec (CGSecurity), The Sleuth Kit and Android adb.",
    "resources": [
      "resources/engines/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 220
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "languages": [
          "English",
          "Italian"
        ],
        "displayLanguageSelector": false
      }
    },
    "publisher": "RecovMe"
  }
}
